# Lumina environment variables
# Copy to /usr/local/lumina/.env.local on pi5 (never commit real secrets)

NODE_ENV=production
PORT=3009

# Google Gemini (required for AI classify / bulk extract)
# Create a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Notion (optional)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Auth / ingest
SESSION_SECRET=
INGEST_API_KEY=

# Telegram ingest bot (optional — user-facing /bulk etc.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# NOC alerts (optional — AI down → Telegram chat monitored by nocbot on pi4)
# Prefer NOC_* names from ~/projects/architecture/telegram.env
# On pi5, same values as alwayson/auth-gateway: TELEGRAM_TOKEN + TELEGRAM_CHAT_ID=502550514
NOC_TELEGRAM_TOKEN=
NOC_TELEGRAM_CHAT_ID=502550514
# Fallbacks if NOC_* unset: TELEGRAM_TOKEN, TELEGRAM_CHAT_ID
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=502550514

# Email ingest (optional)
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=

# Push notifications (optional)
NTFY_TOPIC=

# Public base URL
NEXT_PUBLIC_BASE_URL=https://myweb.tail075174.ts.net
