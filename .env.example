# Lumina environment variables
# Copy to /usr/local/lumina/.env.local on pi5 (never commit real secrets)

NODE_ENV=production
PORT=3009

# Google Gemini (required for AI classify / bulk extract)
# Create a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Notion (optional)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Auth / ingest
SESSION_SECRET=
INGEST_API_KEY=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Email ingest (optional)
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=

# Push notifications (optional)
NTFY_TOPIC=

# Public base URL
NEXT_PUBLIC_BASE_URL=https://myweb.tail075174.ts.net
